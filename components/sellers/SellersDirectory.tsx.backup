/* eslint-disable @next/next/no-img-element */
"use client";
import Link from "next/link";
import { useMemo, useState } from "react";
import type { BrandSection } from "@/data/sellerDirectoryFromSheet";

export default function SellersDirectory({ brands }: { brands: BrandSection[] }) {
  const [search, setSearch] = useState("");
  const sections = useMemo(() => {
    const q = search.trim().toLocaleLowerCase();
    return brands.map(brand => ({ ...brand, sellers: q && !brand.name.toLocaleLowerCase().includes(q)
      ? brand.sellers.filter(s => `${s.name} ${s.spreadsheetSeller} ${s.description}`.toLocaleLowerCase().includes(q))
      : brand.sellers
    })).filter(b => !q || b.name.toLocaleLowerCase().includes(q) || b.sellers.length > 0);
  }, [brands, search]);
  const totalSellers = new Set(brands.flatMap(b => b.sellers.map(s => s.spreadsheetSeller))).size;
  return <main className="relative min-h-screen bg-[#070709] px-4 pb-28 pt-24 text-white md:px-8 md:pt-32">
    <div aria-hidden className="pointer-events-none absolute inset-x-0 top-0 h-[450px] bg-[radial-gradient(ellipse_at_50%_0%,rgba(149,110,255,.17),transparent_65%)]" />
    <div className="relative mx-auto max-w-7xl">
      <div className="mb-12 text-center">
        <p className="mb-3 text-xs font-semibold uppercase tracking-[.32em] text-violet-300">CRAVATTA DIRECTORY</p>
        <h1 className="text-4xl font-bold tracking-tight md:text-6xl">Seller per <span className="bg-gradient-to-r from-[#c1a3ff] to-[#70d6bd] bg-clip-text text-transparent">brand</span></h1>
        <p className="mx-auto mt-4 max-w-xl text-sm leading-6 text-white/55 md:text-base">Esplora i venditori per marchio. Visita il loro store o guarda direttamente gli articoli nello Spreadsheet.</p>
        <p className="mt-4 text-xs text-white/40">{brands.length} brand · {totalSellers} seller</p>
      </div>
      <div className="sticky top-2 z-20 mx-auto mb-12 max-w-2xl rounded-2xl border border-white/10 bg-[#18171f]/95 p-2 shadow-xl shadow-black/30 backdrop-blur-xl">
        <label htmlFor="seller-search" className="sr-only">Cerca brand o seller</label>
        <input id="seller-search" value={search} onChange={e => setSearch(e.target.value)} placeholder="Cerca un brand o un seller..." className="w-full rounded-xl bg-white/[.05] px-5 py-3.5 text-sm text-white outline-none placeholder:text-white/35 focus:ring-2 focus:ring-violet-500/50" />
      </div>
      {sections.length === 0 && <p className="py-20 text-center text-white/55">Nessun risultato per questa ricerca.</p>}
      <div className="space-y-14">
        {sections.map(brand => <section id={brand.name.toLowerCase().replace(/[^a-z0-9]+/g,"-")} key={brand.id} className="overflow-hidden rounded-[28px] border border-white/10 bg-[#111116] shadow-xl shadow-black/20">
          <div className="relative min-h-[185px] overflow-hidden border-b border-white/10 md:min-h-[235px]">
            {brand.cover && <img src={brand.cover} alt="" loading="lazy" className="absolute inset-0 h-full w-full object-cover opacity-50" />}
            <div className="absolute inset-0 bg-gradient-to-r from-black/95 via-black/55 to-black/20" />
            <div className="relative flex min-h-[185px] flex-col justify-end p-6 md:min-h-[235px] md:p-9">
              <span className="mb-2 text-xs uppercase tracking-[.2em] text-violet-200">Brand directory</span>
              <h2 className="text-3xl font-bold tracking-tight md:text-5xl">{brand.name}</h2>
              {brand.description && <p className="mt-2 max-w-2xl text-sm text-white/65">{brand.description}</p>}
              <p className="mt-3 text-xs text-white/50">{brand.sellers.length} seller</p>
            </div>
          </div>
          <div className="grid gap-4 p-4 sm:grid-cols-2 md:p-6 xl:grid-cols-3">
            {brand.sellers.map((seller, i) => <div key={`${seller.spreadsheetSeller}-${i}`} className="flex flex-col justify-between rounded-2xl border border-white/10 bg-white/[.035] p-5 transition hover:border-violet-400/35 hover:bg-white/[.055]">
              <div className="mb-5 flex items-start gap-3">
                <div className="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-white/10 bg-white/10 text-xl font-bold text-violet-200">
                  {seller.image ? <img src={seller.image} alt="" loading="lazy" className="h-full w-full object-cover" /> : seller.name.charAt(0).toUpperCase()}
                </div>
                <div className="min-w-0"><div className="flex items-center gap-2"><h3 className="truncate text-lg font-semibold">{seller.name}</h3>{seller.verified && <span title="Verificato" className="text-emerald-300">✓</span>}</div>
                {seller.description && <p className="mt-1 line-clamp-2 text-xs leading-relaxed text-white/50">{seller.description}</p>}</div>
              </div>
              <div className="grid grid-cols-2 gap-2">
                {seller.officialUrl ? <a href={seller.officialUrl} target="_blank" rel="noopener noreferrer" className="rounded-xl border border-white/15 px-2 py-3 text-center text-xs font-semibold transition hover:bg-white/10">Sito ufficiale ↗</a> : <span className="rounded-xl border border-white/5 px-2 py-3 text-center text-xs text-white/30">Sito non disponibile</span>}
                <Link href={`/spreadsheet?seller=${encodeURIComponent(seller.spreadsheetSeller)}`} className="rounded-xl bg-gradient-to-r from-violet-600 to-violet-500 px-2 py-3 text-center text-xs font-semibold transition hover:brightness-110">Vedi articoli →</Link>
              </div>
            </div>)}
            {brand.sellers.length === 0 && <p className="col-span-full py-8 text-center text-sm text-white/45">Nessun seller associato a questo brand.</p>}
          </div>
        </section>)}
      </div>
      <div className="mt-12 text-center"><Link href="/spreadsheet" className="inline-block rounded-xl border border-white/15 px-6 py-3 text-sm text-white/75 hover:bg-white/10">Esplora tutti gli articoli →</Link></div>
    </div>
  </main>;
}
