import { unstable_cache } from "next/cache";
import { google } from "googleapis";
import fs from "node:fs";
import path from "node:path";

function mustEnv(name: string) {
  const v = process.env[name];
  if (!v) throw new Error(`Missing env: ${name}`);
  return v;
}

function normalizePrivateKey(key: string) {
  return key.replace(/\\n/g, "\n");
}

type SA = { email: string; key: string };

function tryReadServiceAccount(): SA | null {
  // 1) JSON in env (consigliato)
  const jsonEnv = process.env.GOOGLE_SERVICE_ACCOUNT_JSON;
  if (jsonEnv) {
    try {
      const obj = JSON.parse(jsonEnv);
      if (obj?.client_email && obj?.private_key) {
        return { email: obj.client_email, key: obj.private_key };
      }
    } catch {}
  }

  // 2) file path in env
  const fileEnv =
    process.env.GOOGLE_APPLICATION_CREDENTIALS ||
    process.env.GOOGLE_SERVICE_ACCOUNT_FILE ||
    process.env.GOOGLE_CREDENTIALS_FILE;

  const candidates = [
    fileEnv,
    "scraper/service-account.json",
    "service-account.json",
  ].filter(Boolean) as string[];

  for (const p of candidates) {
    try {
      const abs = path.isAbsolute(p) ? p : path.join(process.cwd(), p);
      if (!fs.existsSync(abs)) continue;
      const raw = fs.readFileSync(abs, "utf8");
      const obj = JSON.parse(raw);
      if (obj?.client_email && obj?.private_key) {
        return { email: obj.client_email, key: obj.private_key };
      }
    } catch {}
  }

  // 3) classiche env separate (fallback)
  const email =
    process.env.GOOGLE_SERVICE_ACCOUNT_EMAIL ||
    process.env.GOOGLE_CLIENT_EMAIL ||
    process.env.GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL;

  const key =
    process.env.GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY ||
    process.env.GOOGLE_PRIVATE_KEY ||
    process.env.GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_PEM;

  if (email && key) return { email, key };

  return null;
}

function getAuth() {
  const sa = tryReadServiceAccount();
  if (!sa) {
    throw new Error(
      "Missing Google Service Account credentials. Provide GOOGLE_SERVICE_ACCOUNT_JSON or GOOGLE_APPLICATION_CREDENTIALS or scraper/service-account.json or GOOGLE_CLIENT_EMAIL+GOOGLE_PRIVATE_KEY."
    );
  }

  return new google.auth.JWT(
    sa.email,
    undefined,
    normalizePrivateKey(sa.key),
    ["https://www.googleapis.com/auth/spreadsheets.readonly"]
  );
}

const TAB = process.env.ITEMS_TAB || "items";
const COL_LAST = process.env.ITEMS_COL_LAST || "K";

async function fetchHeader() {
  const auth = getAuth();
  const sheets = google.sheets({ version: "v4", auth });
  const spreadsheetId = mustEnv("SHEET_ID");

  const range = `${TAB}!A1:${COL_LAST}1`;
  const res = await sheets.spreadsheets.values.get({
    spreadsheetId,
    range,
    valueRenderOption: "UNFORMATTED_VALUE",
  });

  return (res.data.values?.[0] ?? []).map((x) => String(x ?? "").trim());
}

export const getHeader = unstable_cache(fetchHeader, ["sheet-header"], {
  revalidate: 300,
});

async function fetchItemsPage(page: number, limit: number) {
  const auth = getAuth();
  const sheets = google.sheets({ version: "v4", auth });
  const spreadsheetId = mustEnv("SHEET_ID");

  const startRow = 2 + (page - 1) * limit;
  const endRow = startRow + limit - 1;

  const range = `${TAB}!A${startRow}:${COL_LAST}${endRow}`;

  const [header, res] = await Promise.all([
    getHeader(),
    sheets.spreadsheets.values.get({
      spreadsheetId,
      range,
      valueRenderOption: "UNFORMATTED_VALUE",
    }),
  ]);

  const values = res.data.values ?? [];
  return values.map((row) => {
    const obj: Record<string, any> = {};
    for (let i = 0; i < header.length; i++) {
      const key = header[i] || `col_${i}`;
      obj[key] = row[i] ?? "";
    }
    return obj;
  });
}

export const getItemsPage = unstable_cache(fetchItemsPage, ["items-page"], {
  revalidate: 60,
});
