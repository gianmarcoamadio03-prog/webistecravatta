import { unstable_cache } from "next/cache";
import { google } from "googleapis";

function mustEnv(name: string) {
  const v = process.env[name];
  if (!v) throw new Error(`Missing env: ${name}`);
  return v;
}

function normalizePrivateKey(key: string) {
  return key.replace(/\\n/g, "\n");
}

function getAuth() {
  const email =
    process.env.GOOGLE_SERVICE_ACCOUNT_EMAIL ||
    process.env.GOOGLE_CLIENT_EMAIL ||
    process.env.GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL;

  const key =
    process.env.GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY ||
    process.env.GOOGLE_PRIVATE_KEY ||
    process.env.GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_PEM;

  if (!email) throw new Error("Missing env: GOOGLE_SERVICE_ACCOUNT_EMAIL (or GOOGLE_CLIENT_EMAIL)");
  if (!key) throw new Error("Missing env: GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY (or GOOGLE_PRIVATE_KEY)");

  return new google.auth.JWT(
    email,
    undefined,
    normalizePrivateKey(key),
    ["https://www.googleapis.com/auth/spreadsheets.readonly"]
  );
}

const TAB = process.env.ITEMS_TAB || "items";
/**
 * Riduci range per tenere piccolo il payload.
 * Default A..K (11 colonne). Se ti serve, aumenta (es: M) ma occhio alla size.
 */
const COL_LAST = process.env.ITEMS_COL_LAST || "K";

async function fetchHeader() {
  const auth = getAuth();
  const sheets = google.sheets({ version: "v4", auth });
  const spreadsheetId = mustEnv("SHEET_ID");

  const range = `${TAB}!A1:${COL_LAST}1`;
  const res = await sheets.spreadsheets.values.get({
    spreadsheetId,
    range,
    valueRenderOption: "UNFORMATTED_VALUE",
  });

  const header = (res.data.values?.[0] ?? []).map((x) =>
    String(x ?? "").trim()
  );

  return header;
}

export const getHeader = unstable_cache(fetchHeader, ["sheet-header"], {
  revalidate: 300,
});

async function fetchItemsPage(page: number, limit: number) {
  const auth = getAuth();
  const sheets = google.sheets({ version: "v4", auth });
  const spreadsheetId = mustEnv("SHEET_ID");

  const startRow = 2 + (page - 1) * limit; // 1 = header
  const endRow = startRow + limit - 1;

  const range = `${TAB}!A${startRow}:${COL_LAST}${endRow}`;

  const [header, res] = await Promise.all([
    getHeader(),
    sheets.spreadsheets.values.get({
      spreadsheetId,
      range,
      valueRenderOption: "UNFORMATTED_VALUE",
    }),
  ]);

  const values = res.data.values ?? [];
  // map to objects using header keys (keeps client flexible)
  const rows = values.map((row) => {
    const obj: Record<string, any> = {};
    for (let i = 0; i < header.length; i++) {
      const key = header[i] || `col_${i}`;
      obj[key] = row[i] ?? "";
    }
    return obj;
  });

  return rows;
}

/**
 * Cache PER PAGINA: evita il limite 2MB della data cache.
 * Key include page+limit automaticamente perché sono argomenti della funzione.
 */
export const getItemsPage = unstable_cache(fetchItemsPage, ["items-page"], {
  revalidate: 60,
});
